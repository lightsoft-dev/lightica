# Lightsoft fork (LIGH-258): the Lightica release build talks to the team
# client (Tailscale :3444), which serves the production API on /api and /ws and
# the team web on /. Keep both values equal to LIGHTICA_SERVER_URL in
# lightica.ts (a test checks). Loaded by the `*:prod` scripts via dotenv-cli
# (see package.json); .env.production.local overrides it key by key.
EXPO_PUBLIC_API_URL=https://mac-studio.taile83671.ts.net:3444
EXPO_PUBLIC_WEB_URL=https://mac-studio.taile83671.ts.net:3444
