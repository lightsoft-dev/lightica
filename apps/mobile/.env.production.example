# Copy this file to .env.production.local and edit it before running a
# production-variant build. The .local file is gitignored.
#
# These are the Lightica defaults: the team client on the tailnet. Replace them
# to point a personal build at another backend.
EXPO_PUBLIC_API_URL=https://mac-studio.taile83671.ts.net:3444
EXPO_PUBLIC_WEB_URL=https://mac-studio.taile83671.ts.net:3444

# Optional: use your own reverse-domain if your Apple ID cannot sign the
# default production bundle ID (dev.lightsoft.lightica.mobile).
# EXPO_BUNDLE_IDENTIFIER_PROD=com.yourname.lightica
