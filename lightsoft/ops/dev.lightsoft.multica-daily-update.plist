<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed as ~/Library/LaunchAgents/dev.lightsoft.multica-daily-update.plist
     (__HOME__ is replaced at install time). Runs daily at 05:00 local time; a run
     missed while the Mac slept starts on wake. See lightsoft/ops/README.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.lightsoft.multica-daily-update</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.multica/ops/daily-update.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>5</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/.multica/ops/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.multica/ops/logs/launchd.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
