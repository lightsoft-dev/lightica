<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed as ~/Library/LaunchAgents/dev.lightsoft.multica-secrets.plist by
     lightsoft/secrets/install.sh (__HOME__ is replaced).
     See lightsoft/secrets/README.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.lightsoft.multica-secrets</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.multica/secrets/bin/lightsoft-secrets-server</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LIGHTSOFT_SECRETS_ADDR</key>
    <string>127.0.0.1:13300</string>
    <key>LIGHTSOFT_SECRETS_API_URL</key>
    <string>http://127.0.0.1:8080</string>
    <key>LIGHTSOFT_SECRETS_PUBLIC_URL</key>
    <string>https://mac-studio.taile83671.ts.net:3444/lightsoft-secrets</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>__HOME__/.multica/secrets</string>
  <key>StandardOutPath</key>
  <string>__HOME__/.multica/secrets/logs/service.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.multica/secrets/logs/service.log</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
